<script>

    /* =====================================================
       شاشة الترحيب
    ===================================================== */

    window.addEventListener(
        "load",
        function () {

            setTimeout(
                function () {

                    const welcome =
                        document.getElementById(
                            "welcomeScreen"
                        );

                    welcome.classList.add(
                        "hide"
                    );

                },
                1500
            );

        }
    );


    /* =====================================================
       إعدادات المتجر
    ===================================================== */

    const whatsappNumber =
        "218911304841";


    const TRIPOLI_DELIVERY =
        20;


    /* =====================================================
       السلة
    ===================================================== */

    let cart =
        JSON.parse(
            localStorage.getItem(
                "darAlMiskCart"
            )
        ) || [];


    /* =====================================================
       حفظ السلة
    ===================================================== */

    function saveCart() {

        localStorage.setItem(
            "darAlMiskCart",
            JSON.stringify(cart)
        );

    }


    /* =====================================================
       إضافة منتج
    ===================================================== */

    function addToCart(
        name,
        price
    ) {

        const existing =
            cart.find(
                item =>
                    item.name === name
            );


        if (existing) {

            existing.quantity++;

        }

        else {

            cart.push({

                name: name,

                price: price,

                quantity: 1

            });

        }


        saveCart();

        updateCart();


        showToast(

            "✓ تمت إضافة " +
            name +
            " إلى السلة"

        );

    }


    /* =====================================================
       الإشعار
    ===================================================== */

    let toastTimer;


    function showToast(
        message
    ) {

        const toast =
            document.getElementById(
                "toast"
            );


        toast.textContent =
            message;


        toast.classList.add(
            "show"
        );


        clearTimeout(
            toastTimer
        );


        toastTimer =
            setTimeout(
                function () {

                    toast.classList.remove(
                        "show"
                    );

                },
                2300
            );

    }


    /* =====================================================
       تحديث السلة
    ===================================================== */

    function updateCart() {

        const container =
            document.getElementById(
                "cartItems"
            );


        container.innerHTML = "";


        let total = 0;

        let count = 0;


        if (
            cart.length === 0
        ) {

            container.innerHTML = `

                <div class="empty-cart">

                    🛍️

                    <br><br>

                    السلة فارغة

                    <br>

                    اختر عطرك المفضل
                    وأضفه إلى السلة.

                </div>

            `;

        }


        cart.forEach(
            function (
                item,
                index
            ) {

                const itemTotal =
                    item.price *
                    item.quantity;


                total += itemTotal;

                count +=
                    item.quantity;


                const div =
                    document.createElement(
                        "div"
                    );


                div.className =
                    "cart-item";


                div.innerHTML = `

                    <strong>
                        ${item.name}
                    </strong>

                    <div class="cart-item-row">

                        <div class="quantity">

                            <button
                                onclick="
                                    changeQuantity(
                                        ${index},
                                        -1
                                    )
                                ">

                                −

                            </button>


                            <span>

                                ${item.quantity}

                            </span>


                            <button
                                onclick="
                                    changeQuantity(
                                        ${index},
                                        1
                                    )
                                ">

                                +

                            </button>

                        </div>


                        <strong>

                            ${itemTotal}
                            د.ل

                        </strong>


                        <button
                            class="remove-btn"
                            onclick="
                                removeItem(
                                    ${index}
                                )
                            ">

                            حذف

                        </button>

                    </div>

                `;


                container.appendChild(
                    div
                );

            }
        );


        document.getElementById(
            "cartCount"
        ).textContent =
            count;


        document.getElementById(
            "productsTotal"
        ).textContent =
            total;


        updateDelivery();

    }


    /* =====================================================
       تغيير الكمية
    ===================================================== */

    function changeQuantity(
        index,
        amount
    ) {

        cart[index].quantity +=
            amount;


        if (
            cart[index].quantity <= 0
        ) {

            cart.splice(
                index,
                1
            );

        }


        saveCart();

        updateCart();

    }


    /* =====================================================
       حذف المنتج
    ===================================================== */

    function removeItem(
        index
    ) {

        cart.splice(
            index,
            1
        );


        saveCart();

        updateCart();

    }


    /* =====================================================
       فتح السلة
    ===================================================== */

    function openCart() {

        document
            .getElementById(
                "cartOverlay"
            )
            .classList.add(
                "active"
            );


        updateCart();

    }


    /* =====================================================
       إغلاق السلة
    ===================================================== */

    function closeCart() {

        document
            .getElementById(
                "cartOverlay"
            )
            .classList.remove(
                "active"
            );

    }


    /* =====================================================
       التوصيل
    ===================================================== */

    function updateDelivery() {

        const city =
            document.getElementById(
                "customerCity"
            ).value;


        let delivery = 0;


        let deliveryText =
            "اختر المدينة";


        if (

            city === "طرابلس" ||

            city === "ضواحي طرابلس"

        ) {

            delivery =
                TRIPOLI_DELIVERY;


            deliveryText =
                "20 د.ل";

        }


        else if (
            city
        ) {

            deliveryText =
                "على الخاص";

        }


        document.getElementById(
            "deliveryPrice"
        ).textContent =
            deliveryText;


        const productsTotal =
            cart.reduce(

                function (
                    sum,
                    item
                ) {

                    return (

                        sum +
                        item.price *
                        item.quantity

                    );

                },

                0

            );


        if (

            city === "طرابلس" ||

            city === "ضواحي طرابلس"

        ) {

            document.getElementById(
                "cartTotal"
            ).textContent =

                (

                    productsTotal +
                    delivery

                ) +

                " د.ل";

        }


        else {

            document.getElementById(
                "cartTotal"
            ).textContent =

                productsTotal +

                " د.ل";

        }

    }


    /* =====================================================
       إرسال الطلب إلى واتساب
    ===================================================== */

    function sendToWhatsApp() {

        if (
            cart.length === 0
        ) {

            alert(
                "السلة فارغة، أضف عطرًا أولًا."
            );

            return;

        }


        const name =
            document.getElementById(
                "customerName"
            ).value.trim();


        const phone =
            document.getElementById(
                "customerPhone"
            ).value.trim();


        const city =
            document.getElementById(
                "customerCity"
            ).value;


        const address =
            document.getElementById(
                "customerAddress"
            ).value.trim();


        const notes =
            document.getElementById(
                "customerNotes"
            ).value.trim();


        if (

            !name ||

            !phone ||

            !city ||

            !address

        ) {

            alert(

                "يرجى إدخال الاسم ورقم الهاتف والمدينة والعنوان."

            );

            return;

        }


        let productsTotal = 0;


        let message =

            "🛍️ *طلب جديد من دار المِسك والعود*\n\n";


        message +=

            "👤 *اسم العميل:* " +
            name +
            "\n";


        message +=

            "📞 *رقم الهاتف:* " +
            phone +
            "\n";


        message +=

            "📍 *المدينة:* " +
            city +
            "\n";


        message +=

            "🏠 *العنوان:* " +
            address +
            "\n";


        if (notes) {

            message +=

                "📝 *ملاحظات:* " +
                notes +
                "\n";

        }


        message +=

            "\n🧴 *المنتجات:*\n";


        cart.forEach(
            function (
                item
            ) {

                const itemTotal =
                    item.price *
                    item.quantity;


                productsTotal +=
                    itemTotal;


                message +=

                    "• " +
                    item.name +
                    " × " +
                    item.quantity +
                    " = " +
                    itemTotal +
                    " د.ل\n";

            }
        );


        message +=

            "\n💵 *قيمة المنتجات:* " +
            productsTotal +
            " د.ل\n";


        if (

            city === "طرابلس" ||

            city === "ضواحي طرابلس"

        ) {

            const total =

                productsTotal +
                TRIPOLI_DELIVERY;


            message +=

                "🚚 *التوصيل:* 20 د.ل\n";


            message +=

                "💰 *الإجمالي:* " +
                total +
                " د.ل\n";

        }


        else {

            message +=

                "🚚 *التوصيل:* على الخاص / بالتنسيق مع المكتب\n";


            message +=

                "💰 *الإجمالي:* " +
                productsTotal +
                " د.ل + تكلفة التوصيل\n";

        }


        message +=

            "\n📍 *موقع التسليم:*\n" +

            "يرجى إرسال موقع المكان الذي " +

            "ترغب باستلام الطلب فيه عبر واتساب " +

            "بعد إرسال هذه الرسالة.";


        const whatsappURL =

            "https://wa.me/" +

            whatsappNumber +

            "?text=" +

            encodeURIComponent(
                message
            );


        window.open(
            whatsappURL,
            "_blank"
        );

    }


    /* =====================================================
       الانتقال للأقسام
    ===================================================== */

    function scrollToProducts(
        id
    ) {

        document
            .getElementById(
                id
            )
            .scrollIntoView({

                behavior:
                    "smooth"

            });

    }


    /* =====================================================
       تشغيل السلة
    ===================================================== */

    updateCart();

</script>


